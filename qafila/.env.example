# Port HTTP
PORT=4000

# Ordre des fournisseurs de résultats (séparés par des virgules).
# Les fournisseurs non configurés sont ignorés automatiquement.
#   brave   -> API officielle Brave Search (nécessite BRAVE_API_KEY)
#   searxng -> instance SearXNG auto-hébergée (nécessite SEARXNG_URL, cf. docker-compose)
#   ddg     -> lecture de DuckDuckGo lite, sans clé (web uniquement)
#   bing    -> lecture directe des pages Bing, sans clé (web, images, actus)
PROVIDERS=brave,searxng,ddg,bing

# Clé Brave Search API (gratuit : 2000 requêtes/mois) https://brave.com/search/api/
BRAVE_API_KEY=

# URL de l'instance SearXNG (ex : http://searxng:8080 avec docker-compose)
SEARXNG_URL=

# Langue / région par défaut
DEFAULT_LANG=fr-FR

# Cache des résultats (secondes) et limite de requêtes par IP et par minute
CACHE_TTL=300
RATE_LIMIT_PER_MIN=60
