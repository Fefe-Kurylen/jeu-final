{
  "name": "imperium-antiquitas",
  "version": "1.0.0",
  "description": "Jeu de strategie MMO style Travian - iOS & Android",
  "main": "src/server.js",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "api": "node src/server.js",
    "start": "node src/server.js",
    "build": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test": "npm run lint && npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "node tests/api-e2e.mjs && node tests/compliance-e2e.mjs",
    "test:smoke": "node tests/browser-smoke.cjs",
    "sync": "npx cap sync",
    "ios": "npx cap sync ios && npx cap open ios",
    "android": "npx cap sync android && npx cap open android",
    "ios:build": "npx cap sync ios && npx cap copy ios",
    "android:build": "npx cap sync android && npx cap copy android",
    "build:3d": "node tools/build-3d.cjs",
    "build:assets": "node tools/build-assets.cjs --png",
    "lint": "node tests/lint-frontend.cjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "2.4.3",
    "compression": "^1.8.1",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "^4.22.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "9.0.2",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/app": "^8.0.1",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@capacitor/haptics": "^8.0.1",
    "@capacitor/ios": "^8.1.0",
    "@capacitor/keyboard": "^8.0.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.1",
    "@revenuecat/purchases-capacitor": "^13.7.4",
    "eslint": "^9.39.5",
    "three": "^0.170.0",
    "typescript": "^5.9.3"
  }
}
