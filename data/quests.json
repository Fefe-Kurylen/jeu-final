    { "key": "b_SILO", "title": "Grenier", "text": "Grenier au niveau {level}", "goal": { "type": "building", "building": "SILO" }, "levels": [1, 3, 5, 7, 10, 13, 16, 20], "rewardFactor": 0.5, "go": { "building": "SILO" } },
    { "key": "b_RALLY_POINT", "title": "Place de rassemblement", "text": "Place de rassemblement au niveau {level}", "goal": { "type": "building", "building": "RALLY_POINT" }, "levels": [1, 3, 5, 10, 15], "rewardFactor": 0.5, "go": { "building": "RALLY_POINT" } },
    { "key": "b_BARRACKS", "title": "Caserne", "text": "Caserne au niveau {level}", "goal": { "type": "building", "building": "BARRACKS" }, "levels": [1, 3, 5, 7, 10, 15, 20], "rewardFactor": 0.5, "go": { "building": "BARRACKS" } },
    { "key": "b_ACADEMY", "title": "Académie", "text": "Académie au niveau {level}", "goal": { "type": "building", "building": "ACADEMY" }, "levels": [1, 3, 5, 10, 15, 20], "rewardFactor": 0.5, "go": { "building": "ACADEMY" } },
    { "key": "b_WALL", "title": "Muraille", "text": "Mur au niveau {level}", "goal": { "type": "building", "building": "WALL" }, "levels": [1, 3, 5, 7, 10, 15, 20], "rewardFactor": 0.5, "go": { "building": "WALL" } },
    { "key": "b_EMBASSY", "title": "Ambassade", "text": "Ambassade au niveau {level}", "goal": { "type": "building", "building": "EMBASSY" }, "levels": [1, 5, 7, 10, 15], "rewardFactor": 0.5, "go": { "building": "EMBASSY" } },
