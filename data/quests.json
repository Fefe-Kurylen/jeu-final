{
  "_comment": "Quêtes façon Travian (décision du 26 octobre 2026) : un tutoriel qui guide les premières heures, des tâches de progression par paliers, des quêtes du jour et de la semaine qui aident un peu les joueurs actifs, des succès permanents. Récompenses : ressources seules, livrées dans la ville choisie (dans la limite de l'entrepôt). Les noms des bâtiments viennent de data/buildings.json. Réglages : rewardFactor = part du coût du palier rendue (tâches de bâtiment) ; hours = heures de production de toutes les villes (quêtes du jour, de la semaine, succès), avec un plancher min par ressource.",

  "tutorial": [
    { "key": "t_lumber", "title": "Le bois avant tout", "text": "Construisez un bûcheron sur un des champs autour de la ville : le bois sert à presque tout.", "goal": { "type": "field", "building": "LUMBER", "level": 1, "count": 1 }, "go": { "field": "LUMBER" }, "reward": { "wood": 80, "stone": 100, "iron": 80, "food": 60 } },
    { "key": "t_quarry", "title": "Tailler la pierre", "text": "Construisez une carrière : la pierre bâtit les murs et les grands bâtiments.", "goal": { "type": "field", "building": "QUARRY", "level": 1, "count": 1 }, "go": { "field": "QUARRY" }, "reward": { "wood": 100, "stone": 80, "iron": 100, "food": 60 } },
    { "key": "t_iron", "title": "Le fer des armes", "text": "Construisez une mine de fer : sans fer, pas de soldats.", "goal": { "type": "field", "building": "IRON_MINE", "level": 1, "count": 1 }, "go": { "field": "IRON_MINE" }, "reward": { "wood": 100, "stone": 100, "iron": 60, "food": 60 } },
    { "key": "t_farm", "title": "Nourrir le peuple", "text": "Construisez une ferme : la nourriture nourrit vos habitants et vos troupes.", "goal": { "type": "field", "building": "FARM", "level": 1, "count": 1 }, "go": { "field": "FARM" }, "reward": { "wood": 100, "stone": 100, "iron": 100, "food": 40 } },
    { "key": "t_field2", "title": "Produire davantage", "text": "Améliorez un de vos champs au niveau 2 : chaque niveau produit plus.", "goal": { "type": "anyField", "level": 2 }, "go": { "field": "ANY" }, "reward": { "wood": 150, "stone": 150, "iron": 150, "food": 100 } },
    { "key": "t_main2", "title": "Le cœur de la ville", "text": "Améliorez le Bâtiment principal au niveau 2 : il accélère toutes vos constructions.", "goal": { "type": "building", "building": "MAIN_HALL", "level": 2 }, "go": { "building": "MAIN_HALL" }, "reward": { "wood": 200, "stone": 200, "iron": 150, "food": 100 } },
    { "key": "t_warehouse", "title": "Ranger les réserves", "text": "Construisez un entrepôt : il garde plus de bois, de pierre et de fer.", "goal": { "type": "building", "building": "WAREHOUSE", "level": 1 }, "go": { "building": "WAREHOUSE" }, "reward": { "wood": 150, "stone": 150, "iron": 150, "food": 100 } },
    { "key": "t_silo", "title": "Le grenier", "text": "Construisez un grenier : il garde plus de nourriture.", "goal": { "type": "building", "building": "SILO", "level": 1 }, "go": { "building": "SILO" }, "reward": { "wood": 150, "stone": 150, "iron": 150, "food": 150 } },
    { "key": "t_rally", "title": "Rassembler les troupes", "text": "Construisez la Place de rassemblement : c'est d'ici que partent vos armées.", "goal": { "type": "building", "building": "RALLY_POINT", "level": 1 }, "go": { "building": "RALLY_POINT" }, "reward": { "wood": 200, "stone": 200, "iron": 200, "food": 100 } },
    { "key": "t_main3", "title": "Une ville qui grandit", "text": "Améliorez le Bâtiment principal au niveau 3 : il ouvre la caserne, l'académie et le mur.", "goal": { "type": "building", "building": "MAIN_HALL", "level": 3 }, "go": { "building": "MAIN_HALL" }, "reward": { "wood": 250, "stone": 200, "iron": 300, "food": 150 } },
    { "key": "t_barracks", "title": "La caserne", "text": "Construisez la caserne : elle forme l'infanterie et les archers.", "goal": { "type": "building", "building": "BARRACKS", "level": 1 }, "go": { "building": "BARRACKS" }, "reward": { "wood": 200, "stone": 150, "iron": 200, "food": 250 } },
    { "key": "t_recruit", "title": "Premiers soldats", "text": "Recrutez 5 soldats à la caserne.", "goal": { "type": "counterTotal", "counter": "units_recruited", "value": 5 }, "go": { "building": "BARRACKS", "recruit": true }, "reward": { "wood": 150, "stone": 150, "iron": 150, "food": 300 } },
    { "key": "t_army", "title": "Une armée en campagne", "text": "Formez une armée à la Place de rassemblement et donnez-lui vos soldats.", "goal": { "type": "army" }, "go": { "tab": "army" }, "reward": { "wood": 150, "stone": 150, "iron": 150, "food": 150 } },
    { "key": "t_tribe", "title": "Chasser les tribus", "text": "Attaquez la tribu d'un point de ressource proche et gagnez le combat : son butin est à vous.", "goal": { "type": "reportWin", "kind": "TRIBE", "value": 1 }, "go": { "tab": "map", "tribe": true }, "reward": { "wood": 300, "stone": 300, "iron": 300, "food": 300 } },
    { "key": "t_expedition", "title": "L'aventure du héros", "text": "Envoyez votre héros en expédition (onglet Héros) : il revient avec de l'expérience, de l'or et parfois un objet.", "goal": { "type": "counterTotal", "counter": "expedition_sent", "value": 1 }, "go": { "tab": "hero" }, "reward": { "wood": 300, "stone": 300, "iron": 300, "food": 300 } },
    { "key": "t_embassy", "title": "Se faire des alliés", "text": "Construisez l'Ambassade : au niveau 5, elle permet de rejoindre une alliance.", "goal": { "type": "building", "building": "EMBASSY", "level": 1 }, "go": { "building": "EMBASSY" }, "reward": { "wood": 300, "stone": 300, "iron": 300, "food": 300 } }
  ],

  "tasks": [
    { "key": "fields_LUMBER", "title": "Bûcherons", "text": "Tous vos bûcherons au niveau {level}", "goal": { "type": "field", "building": "LUMBER", "all": true }, "levels": [1, 2, 3, 4, 5, 6, 7, 8, 10, 12, 15, 20], "rewardFactor": 1.0, "go": { "field": "LUMBER" } },
    { "key": "fields_QUARRY", "title": "Carrières", "text": "Toutes vos carrières au niveau {level}", "goal": { "type": "field", "building": "QUARRY", "all": true }, "levels": [1, 2, 3, 4, 5, 6, 7, 8, 10, 12, 15, 20], "rewardFactor": 1.0, "go": { "field": "QUARRY" } },
