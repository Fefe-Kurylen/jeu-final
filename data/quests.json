    { "key": "b_HERO_MANSION", "title": "Manoir du héros", "text": "Manoir du héros au niveau {level}", "goal": { "type": "building", "building": "HERO_MANSION" }, "levels": [1, 5, 10], "rewardFactor": 0.5, "go": { "building": "HERO_MANSION" } },
