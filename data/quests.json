    { "key": "units", "title": "Armée", "text": "Recruter {level} soldats au total", "goal": { "type": "counterTotal", "counter": "units_recruited" }, "levels": [10, 50, 200, 500, 2000, 5000], "rewardPerLevel": 3, "go": { "building": "BARRACKS", "recruit": true } },
