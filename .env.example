# ---- Obligatoire ----
# Connexion PostgreSQL (ajouter ?sslmode=require chez la plupart des hébergeurs)
DATABASE_URL=postgresql://monjeu:monjeu123@localhost:5432/monjeu
# Secret des jetons de session : au moins 32 caractères (openssl rand -hex 32). Sans lui le serveur refuse de démarrer,
# sauf en NODE_ENV=development où un secret de développement est utilisé avec un avertissement.
JWT_SECRET=

# ---- Serveur ----
NODE_ENV=production
PORT=3000
# Schéma de base : migrate (défaut, migrations versionnées de prisma/migrations), push (prototypage), none (géré par la plateforme)
DB_SYNC=migrate
# Nombre de processus HTTP (auto = un par CPU ; le premier porte la boucle de jeu)
CLUSTER_WORKERS=1
# Taille du pool de connexions Prisma par processus
DB_POOL=10

# ---- Limites (par minute) ----
RATE_MAX_API=240
RATE_MAX_AUTH=20
RATE_MAX_REGISTER=10

# ---- E-mail (vérification d'adresse, mot de passe oublié) ----
# log = rien n'est envoyé, le message est écrit dans les logs (développement) ; smtp = SMTP_URL ; resend = RESEND_API_KEY
EMAIL_PROVIDER=log
EMAIL_FROM=Imperium Antiquitas <no-reply@votre-domaine.fr>
SMTP_URL=
RESEND_API_KEY=
# Adresse publique de l'API, utilisée dans les liens des e-mails
PUBLIC_URL=https://votre-api.exemple.fr
# Avec un vrai fournisseur, le commerce entre joueurs exige une adresse confirmée (false pour désactiver)
REQUIRE_VERIFIED_EMAIL=true

# ---- Notifications push (inactif si vide) ----
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.imperiumantiquitas.app
APNS_PRODUCTION=false
FCM_SERVICE_ACCOUNT=

# ---- Achats (RevenueCat, inactif si vide) ----
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_AUTH=
PREMIUM_ENTITLEMENT=plus

# ---- Administration ----
# Clé de l'entonnoir analytics (GET /api/analytics/funnel, en-tête x-admin-key)
ADMIN_KEY=
# Régénère tous les points de ressource au démarrage, sur le terrain de la carte du serveur (maintenance uniquement ;
# ne change jamais la carte)
FORCE_RESEED=false

# ---- Carte du serveur ----
# Carte d'un serveur neuf (base vide) : graine de 0 (carte de référence) à 2147483646 ; vide = tirée au hasard.
# Ignorée dès que le monde a sa carte (table WorldConfig). Aperçu : node tools/apercu-carte.cjs --seed=<n>
WORLD_SEED=
