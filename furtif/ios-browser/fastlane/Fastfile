# Furtif Browser — publication App Store.
#   fastlane ios build   : compile sans signature (vérification)
#   fastlane ios beta    : archive signée + envoi TestFlight
#   fastlane ios release : envoi sur App Store Connect + soumission à la validation
default_platform(:ios)

platform :ios do
  before_all do
    sh("cd .. && xcodegen generate")
  end

  desc "Compilation de vérification (appareil iOS, sans signature)"
  lane :build do
    xcodebuild(scheme: "FurtifBrowser", project: "FurtifBrowser.xcodeproj", destination: "generic/platform=iOS", xcargs: "CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO build")
  end

  desc "Clé API App Store Connect (secrets CI)"
  private_lane :api_key do
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false
    )
  end

  desc "Build signé + TestFlight"
  lane :beta do
    api_key
    setup_ci if ENV["CI"]
    # Certificat + profil : importés depuis les secrets (fichier .p12 en base64) ou gérés par Xcode (signature automatique).
    if ENV["IOS_CERT_P12_BASE64"]
      File.write("/tmp/cert.p12", Base64.decode64(ENV["IOS_CERT_P12_BASE64"]))
      import_certificate(certificate_path: "/tmp/cert.p12", certificate_password: ENV["IOS_CERT_PASSWORD"], keychain_name: ENV["MATCH_KEYCHAIN_NAME"] || "login.keychain-db", keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"] || "")
    end
    get_provisioning_profile(app_identifier: "fr.furtif.FurtifBrowser", api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY]) if ENV["IOS_CERT_P12_BASE64"]
    increment_build_number(build_number: ENV["BUILD_NUMBER"] || Time.now.strftime("%Y%m%d%H%M"), xcodeproj: "FurtifBrowser.xcodeproj")
    build_app(scheme: "FurtifBrowser", project: "FurtifBrowser.xcodeproj", export_method: "app-store", xcargs: "-allowProvisioningUpdates")
    upload_to_testflight(api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY], skip_waiting_for_build_processing: true, changelog: "Furtif Browser — build automatique")
  end

  desc "Envoi App Store Connect avec métadonnées et soumission"
  lane :release do
    beta
    upload_to_app_store(
      api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
      skip_binary_upload: true,
      metadata_path: "./fastlane/metadata",
      submit_for_review: true,
      automatic_release: true,
      precheck_include_in_app_purchases: false,
      submission_information: { add_id_info_uses_idfa: false, export_compliance_uses_encryption: false }
    )
  end
end
