generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Deleting an account deletes the player and everything the player owns (cascades below);
// what other players must keep (battle reports) only loses its link to the deleted player.

model Account {
  id              String      @id @default(uuid())
  email           String      @unique
  passwordHash    String
  tokenVersion    Int         @default(0) // bumped on password change: older tokens are refused
  emailVerifiedAt DateTime? // set by the verification link (or a password reset, which proves the mailbox)
  createdAt       DateTime    @default(now())
  player          Player?
  tokens          AuthToken[]
}

// One-time tokens sent by e-mail (address verification, password reset); only the hash is stored
model AuthToken {
  id        String    @id @default(uuid())
  accountId String
  type      String // VERIFY_EMAIL | RESET_PASSWORD
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, type])
}

// Rate-limit counters shared by every process (login, sign-up, admin): one row per key and window
model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int      @default(0)
}

model Player {
  id                String    @id @default(uuid())
  accountId         String    @unique
  name              String    @unique
  faction           String
  gold              Int       @default(0)
  population        Int       @default(0)
  createdAt         DateTime  @default(now())
  lastSeenAt        DateTime  @default(now()) // last authenticated request (10 min resolution)
  premiumUntil      DateTime? // abonnement « Plus » vérifié côté serveur (null = pas d'abonnement)
  cosmetics         Json? // identifiants des cosmétiques possédés
  chatLang          String? // langue des messages du joueur (fr, en…) : celle de ses messages, et celle de la traduction automatique
  chatAutoTranslate Boolean   @default(true)
  chatMutedUntil    DateTime? // messagerie coupée par la modération jusqu'à cette date
  alliancePoints    Int       @default(0) // gagnés en aidant les membres de son alliance, dépensés à la boutique d'alliance
  shopCosmetics     Json? // cosmétiques achetés à la boutique d'alliance (identifiants), distincts des achats intégrés
  nameplate         String? // plaque de nom choisie (cosmétique), dessinée sous ses villes sur la carte
  banner            String? // bannière choisie (cosmétique), plantée devant ses villes sur la carte

  account                Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  cities                 City[]
  armies                 Army[]
  hero                   Hero?
  stats                  PlayerStats?
  ownedReports           BattleReport[]        @relation("ReportOwner")
  sentReports            BattleReport[]        @relation("Attacker")
  recvReports            BattleReport[]        @relation("Defender")
  spyReports             SpyReport[]
  marketOffers           MarketOffer[]
  alliance               AllianceMember?
  expeditions            Expedition[]
  pushTokens             PushToken[]
  notifications          Notification[]
  purchases              Purchase[]
  technologies           PlayerTechnology[]
  researchQueue          ResearchQueueItem[]
  chatMessages           ChatMessage[]
  chatReports            ChatReport[]
  chatReads              ChatRead[]
  blocks                 PlayerBlock[]         @relation("Blocker")
  blockedBy              PlayerBlock[]         @relation("Blocked")
  friendRequestsSent     Friendship[]          @relation("FriendRequester")
  friendRequestsReceived Friendship[]          @relation("FriendAddressee")
  helpRequests           AllianceHelpRequest[]
  helpsGiven             AllianceHelp[]

  @@index([lastSeenAt])
}

model PlayerStats {
  id          String @id @default(uuid())
  playerId    String @unique
  attacksWon  Int    @default(0)
  defensesWon Int    @default(0)
  unitsKilled Int    @default(0)
  unitsLost   Int    @default(0)
  raidsWon    Int    @default(0)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model City {
  id        String  @id @default(uuid())
  playerId  String
  name      String
  x         Int
  y         Int
  isCapital Boolean @default(false)
  settlers  Int     @default(0) // colons formés à la Résidence, en attente dans la capitale

  wood  Float @default(500)
  stone Float @default(500)
  iron  Float @default(500)
  food  Float @default(500)

  maxStorage     Int @default(1000)
  maxFoodStorage Int @default(1000)

  wallHp        Float     @default(1000) // fractional: regenerates continuously on real elapsed time
  wallMaxHp     Int       @default(1000)
  goldAccrued   Float     @default(0) // Treasure Chamber income accumulated until a whole gold coin is paid
  isSieged      Boolean   @default(false)
  wallStructure Float     @default(1) // santé de la muraille (1 = 100 %) : chaque assaut gagné en ôte une part ; à 0 la ville tombe
  siegeStarted  DateTime?

  createdAt DateTime @default(now())

  player        Player              @relation(fields: [playerId], references: [id], onDelete: Cascade)
  buildings     CityBuilding[]
  buildQueue    BuildQueueItem[]
  researchQueue ResearchQueueItem[]
  recruitQueue  RecruitQueueItem[]
  armies        Army[]
  wounded       WoundedUnit[]

  @@unique([x, y])
  @@index([playerId])
  @@map("City")
}

model CityBuilding {
  id     String @id @default(uuid())
  cityId String
  slot   Int
  key    String
  level  Int    @default(1)

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([cityId, slot])
  @@index([cityId, key])
}

model BuildQueueItem {
  id          String   @id @default(uuid())
  cityId      String
  slot        Int
  buildingKey String
  targetLevel Int
  startedAt   DateTime
  endsAt      DateTime
  status      String   @default("QUEUED")

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([cityId, status])
  @@index([status, endsAt])
}

model RecruitQueueItem {
  id          String   @id @default(uuid())
  cityId      String
  unitKey     String
  count       Int
  buildingKey String
  startedAt   DateTime
  endsAt      DateTime
  status      String   @default("RUNNING")

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([cityId])
  @@index([status, endsAt])
}

model Army {
  id         String  @id @default(uuid())
  ownerId    String
  cityId     String?
  name       String
  slot       Int     @default(0)
  x          Int
  y          Int
  status     String  @default("IDLE")
  heroId     String? @unique
  isGarrison Boolean @default(false)

  targetX          Int?
  targetY          Int?
  targetCityId     String?
  targetResourceId String?
  arrivalAt        DateTime?
  departedAt       DateTime? // start of the current move: the client animates the march between departedAt and arrivalAt
  claimedAt        DateTime? // set by the tick while an arrival is being resolved (never twice)

  missionType String?
  carryWood   Int     @default(0)
  carryStone  Int     @default(0)
  carryIron   Int     @default(0)
  carryFood   Int     @default(0)
  carryGold   Int     @default(0)

  harvestResourceType String? // type de ressource en cours de récolte
  settlers            Int     @default(0) // colons embarqués pour fonder une ville (mission FOUND, statut FOUNDING)
  woundedCarry        Json    @default("[]") // blessés qui rentrent avec l'armée : [{ unitKey, count }], déposés à la Tente de soins au retour

  owner Player     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  city  City?      @relation(fields: [cityId], references: [id], onDelete: SetNull)
  hero  Hero?      @relation(fields: [heroId], references: [id], onDelete: SetNull)
  units ArmyUnit[]

  @@index([ownerId])
  @@index([ownerId, status])
  @@index([cityId])
  @@index([status, arrivalAt])
  @@index([targetCityId])
  @@index([targetResourceId])
}

model ArmyUnit {
  id      String @id @default(uuid())
  armyId  String
  unitKey String
  tier    String @default("base")
  count   Int

  army Army @relation(fields: [armyId], references: [id], onDelete: Cascade)

  @@unique([armyId, unitKey])
}

model Hero {
  id            String @id @default(uuid())
  playerId      String @unique
  name          String
  level         Int    @default(1)
  xp            Int    @default(0)
  xpToNextLevel Int    @default(100)

  attack    Int @default(5)
  defense   Int @default(5)
  logistics Int @default(5)
  speed     Int @default(5)

  atkPoints  Int @default(0)
  defPoints  Int @default(0)
  spdPoints  Int @default(0)
  logPoints  Int @default(0)
  statPoints Int @default(5)

  player Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  army   Army?
  items  HeroItem[]
}

model HeroItem {
  id      String @id @default(uuid())
  heroId  String
  itemKey String
  slot    String
  stats   Json?

  hero Hero @relation(fields: [heroId], references: [id], onDelete: Cascade)
}

model WoundedUnit {
  id      String   @id @default(uuid())
  cityId  String
  unitKey String
  count   Int // dans un lit, guérit à healsAt
  waiting Int      @default(0) // en file d'attente : prend un lit libéré (capacité de la Tente de soins)
  healsAt DateTime

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([cityId, unitKey])
  @@index([healsAt])
}

model BattleReport {
  id             String   @id @default(uuid())
  playerId       String? // owner of this copy of the report
  attackerId     String?
  defenderId     String?
  x              Int
  y              Int
  result         String?
  winner         String?
  attackerUnits  Json?
  defenderUnits  Json?
  attackerLosses Json?
  defenderLosses Json?
  loot           Json?
  rounds         Json?
  createdAt      DateTime @default(now())

  owner    Player? @relation("ReportOwner", fields: [playerId], references: [id], onDelete: Cascade)
  attacker Player? @relation("Attacker", fields: [attackerId], references: [id], onDelete: SetNull)
  defender Player? @relation("Defender", fields: [defenderId], references: [id], onDelete: SetNull)

  @@index([playerId, createdAt])
  @@index([attackerId, defenderId, createdAt])
}

model SpyReport {
  id             String   @id @default(uuid())
  playerId       String
  targetPlayerId String?
  targetCityId   String?
  targetType     String?
  targetX        Int
  targetY        Int
  targetName     String?
  cityName       String?
  success        Boolean
  buildings      Json?
  armies         Json?
  resources      Json?
  data           Json?
  createdAt      DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, createdAt])
  @@index([targetPlayerId])
}

model ResourceNode {
  id           String   @id @default(uuid())
  x            Int
  y            Int
  resourceType String
  level        Int      @default(1) // 1, 2, 3 (3 = richest, near center)
  amount       Int      @default(1000)
  maxAmount    Int      @default(1000)
  regenRate    Int      @default(10)
  lastRegen    DateTime @default(now())
  biome        String   @default("forest") // forest, desert, snow

  // Tribus locales défenseurs
  hasDefenders   Boolean   @default(true)
  defenderPower  Int       @default(100) // Puissance totale des défenseurs (même échelle que la puissance d'une armée)
  defenderUnits  Json? // Ex: {"GRE_INF_HOPLITE": 20}
  lastDefeat     DateTime? // Dernière défaite (respawn après X temps)
  respawnMinutes Int       @default(60) // Temps de respawn des défenseurs

  // Système de régénération lié aux armées
  lastArmyDeparture DateTime? // Quand la dernière armée a quitté le point
  hasPlayerArmy     Boolean   @default(false) // Une armée joueur est présente sur le point
  cityId            String? // ville secondaire fondée sur ce point : plus de tribu ni de récolte tant qu'elle existe

  @@unique([x, y])
  @@index([hasDefenders, lastDefeat])
  @@index([hasPlayerArmy])
  @@index([cityId])
}

model MarketOffer {
  id           String   @id @default(uuid())
  sellerId     String
  buyerId      String?
  cityId       String?
  sellResource String
  sellAmount   Int
  buyResource  String
  buyAmount    Int
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())

  seller Player @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([sellerId])
  @@index([buyerId])
}

model Alliance {
  id          String   @id @default(uuid())
  name        String   @unique
  tag         String   @unique
  description String?
  leaderId    String?
  createdAt   DateTime @default(now())

  members              AllianceMember[]
  diplomacy            AllianceDiplomacy[]   @relation("AllianceSource")
  targetOf             AllianceDiplomacy[]   @relation("AllianceTarget")
  invites              AllianceInvite[]
  allyRequestsSent     AllianceAllyRequest[] @relation("AllyRequestFrom")
  allyRequestsReceived AllianceAllyRequest[] @relation("AllyRequestTo")
  helpRequests         AllianceHelpRequest[]
}

model AllianceMember {
  id         String   @id @default(uuid())
  allianceId String
  playerId   String   @unique
  role       String   @default("MEMBER")
  joinedAt   DateTime @default(now())

  alliance Alliance @relation(fields: [allianceId], references: [id], onDelete: Cascade)
  player   Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model AllianceDiplomacy {
  id               String   @id @default(uuid())
  allianceId       String
  targetAllianceId String
  status           String   @default("NEUTRAL")
  changedAt        DateTime @default(now())

  alliance       Alliance @relation("AllianceSource", fields: [allianceId], references: [id], onDelete: Cascade)
  targetAlliance Alliance @relation("AllianceTarget", fields: [targetAllianceId], references: [id], onDelete: Cascade)

  @@unique([allianceId, targetAllianceId])
}

// Proposition d'alliance entre deux alliances (décision du 26 octobre 2026) : le statut ALLY n'existe que des deux côtés,
// une fois la proposition acceptée ; ENNEMI se déclare seul
model AllianceAllyRequest {
  id             String   @id @default(uuid())
  fromAllianceId String
  toAllianceId   String
  createdAt      DateTime @default(now())

  from Alliance @relation("AllyRequestFrom", fields: [fromAllianceId], references: [id], onDelete: Cascade)
  to   Alliance @relation("AllyRequestTo", fields: [toAllianceId], references: [id], onDelete: Cascade)

  @@unique([fromAllianceId, toAllianceId])
  @@index([toAllianceId])
}

// Demande d'aide d'alliance (décision du 26 octobre 2026) sur une construction, une recherche ou les soins d'une ville :
// chaque membre aide une fois, chaque aide retire 1 % du temps restant (1 minute au moins), plafond selon l'Ambassade
model AllianceHelpRequest {
  id         String    @id @default(uuid())
  allianceId String
  playerId   String
  cityId     String
  kind       String // BUILD, RESEARCH, HEAL
  targetId   String // BuildQueueItem, ResearchQueueItem, ou la ville pour les soins
  label      String
  helps      Int       @default(0)
  maxHelps   Int
  createdAt  DateTime  @default(now())
  closedAt   DateTime?

  alliance Alliance       @relation(fields: [allianceId], references: [id], onDelete: Cascade)
  player   Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  given    AllianceHelp[]

  @@index([allianceId, closedAt])
  @@index([playerId, kind, targetId])
}

model AllianceHelp {
  id        String   @id @default(uuid())
  requestId String
  helperId  String
  points    Int      @default(0) // points d'alliance gagnés par cette aide (0 au-delà du plafond du jour)
  createdAt DateTime @default(now())

  request AllianceHelpRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  helper  Player              @relation(fields: [helperId], references: [id], onDelete: Cascade)

  @@unique([requestId, helperId])
  @@index([helperId, createdAt])
}

model Expedition {
  id         String    @id @default(uuid())
  playerId   String
  armyId     String?
  difficulty Int
  enemyPower Int
  duration   Int       @default(1800)
  lootTier   String    @default("COMMON")
  expiresAt  DateTime
  startedAt  DateTime?
  endsAt     DateTime?
  status     String    @default("AVAILABLE")
  won        Boolean?
  xpGained   Int?
  lootGained Json?
  createdAt  DateTime  @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, status])
  @@index([status, endsAt])
  @@index([status, expiresAt])
  @@index([armyId])
}

// Carte du serveur : sa graine, tirée au hasard au premier démarrage d'un serveur neuf (graine 0 = carte de référence,
// gardée par le monde déjà ouvert). Une seule ligne, id = 1, jamais modifiée : changer la graine déplacerait toute la carte
// sous les villes. Voir src/game/world.js et frontend/js/shared/terrain.js (setWorldSeed).
model WorldConfig {
  id        Int       @id @default(1)
  seed      Int
  generator Int // version du terrain qui a tiré la carte (2 = référence, 3 = cartes au hasard), toujours écrite
  readyAt   DateTime? // monde prêt (points de ressource posés) : le serveur ouvre
  createdAt DateTime  @default(now())
}

// Lease taken by the single process that runs the game tick
model TickLock {
  id          Int       @id
  owner       String
  lockedUntil DateTime
  lastTickAt  DateTime? // game time is caught up from this timestamp (database clock)
}

// Joining an alliance requires an invitation from one of its officers
model AllianceInvite {
  id         String   @id @default(uuid())
  allianceId String
  playerId   String
  createdAt  DateTime @default(now())

  alliance Alliance @relation(fields: [allianceId], references: [id], onDelete: Cascade)

  @@unique([allianceId, playerId])
  @@index([playerId])
}

// Jeton de notification push d'un appareil (supprimé avec le compte)
// In-game notifications (décision du 25 octobre 2026): every alert is first a message in the game, with a link to what it
// is about; the mobile push is sent from it
model Notification {
  id        String    @id @default(uuid())
  playerId  String
  kind      String
  title     String
  body      String
  link      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, createdAt])
}

model PushToken {
  id         String   @id @default(uuid())
  playerId   String
  token      String   @unique
  platform   String // ios | android | web
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
}

// Achat ou abonnement vérifié côté serveur (RevenueCat), jamais accordé sur la seule parole du client
model Purchase {
  id            String    @id @default(uuid())
  playerId      String
  store         String    @default("app_store")
  productId     String
  transactionId String    @unique
  purchasedAt   DateTime
  expiresAt     DateTime?
  status        String    @default("ACTIVE") // ACTIVE | EXPIRED | REFUNDED
  raw           Json?
  createdAt     DateTime  @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
}

// Événements d'usage internes (entonnoir d'activation), anonymisés à la suppression du compte
model AnalyticsEvent {
  id        String   @id @default(uuid())
  playerId  String?
  event     String
  props     Json?
  platform  String?
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([playerId, createdAt])
}

// ============== TECHNOLOGIES (recherche à l'Académie, data/technologies.json) ==============
model PlayerTechnology {
  id       String @id @default(uuid())
  playerId String
  techKey  String
  level    Int    @default(0)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, techKey])
}

model ResearchQueueItem {
  id          String   @id @default(uuid())
  playerId    String
  cityId      String
  techKey     String
  targetLevel Int
  cost        Json?
  startedAt   DateTime
  endsAt      DateTime
  status      String   @default("RUNNING") // RUNNING, QUEUED

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([playerId, status])
  @@index([status, endsAt])
}

// ---- Messagerie (décision du 26 octobre 2026) ----
// Canaux : GLOBAL (tout le serveur), ALLIANCE (allianceId), FRIENDS (lu par les amis de l'auteur), PRIVATE (conversation
// "<idA>:<idB>", identifiants triés). Conservation : 7 jours pour le global, 90 jours pour le reste (purge de la boucle).
model ChatMessage {
  id           String   @id @default(uuid())
  channel      String
  allianceId   String?
  conversation String?
  recipientId  String? // PRIVATE : le destinataire
  senderId     String
  text         String
  lang         String? // langue déclarée par l'auteur au moment de l'envoi (traduction automatique si elle diffère)
  share        Json? // rapport de bataille, rapport d'espionnage ou position partagés (copie, lisible par tout le canal)
  createdAt    DateTime @default(now())

  sender       Player            @relation(fields: [senderId], references: [id], onDelete: Cascade)
  translations ChatTranslation[]
  reports      ChatReport[]

  @@index([channel, createdAt])
  @@index([allianceId, createdAt])
  @@index([conversation, createdAt])
  @@index([recipientId, createdAt])
  @@index([senderId, createdAt])
}

// Traductions déjà faites (DeepL) : un message n'est traduit qu'une fois par langue
model ChatTranslation {
  id        String   @id @default(uuid())
  messageId String
  lang      String
  text      String
  fromLang  String?
  createdAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, lang])
}

// Signalement d'un message à la modération
model ChatReport {
  id         String    @id @default(uuid())
  messageId  String
  reporterId String
  reason     String
  createdAt  DateTime  @default(now())
  handledAt  DateTime?
  action     String? // dismiss | delete | mute

  message  ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter Player      @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([messageId, reporterId])
  @@index([handledAt, createdAt])
}

// Dernier message lu par canal (badge des messages non lus) : "global", "alliance", "friends", "private:<idJoueur>"
model ChatRead {
  id         String   @id @default(uuid())
  playerId   String
  channelKey String
  lastReadAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, channelKey])
}

// Un joueur bloqué : ses messages sont cachés partout et il ne peut plus écrire en privé à celui qui l'a bloqué
model PlayerBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker Player @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked Player @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// Amitié : une demande (PENDING) que l'autre accepte (ACCEPTED)
model Friendship {
  id          String    @id @default(uuid())
  requesterId String
  addresseeId String
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?

  requester Player @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee Player @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}
